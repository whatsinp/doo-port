{
  "name": "doo-port",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "nuxt typecheck",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "emulators": "firebase emulators:start",
    "deploy:hosting": "npm run generate && firebase deploy --only hosting:app",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test": "npm run test:unit"
  },
  "dependencies": {
    "@nuxtjs/i18n": "^10.6.0",
    "@nuxtjs/tailwindcss": "^6.14.0",
    "@pinia/nuxt": "^1.0.1",
    "@primevue/nuxt-module": "^5.0.0",
    "@primevue/themes": "^4.5.4",
    "@vueuse/nuxt": "^14.4.0",
    "chart.js": "^4.5.1",
    "dayjs": "^1.11.21",
    "decimal.js": "^10.6.0",
    "firebase": "^12.17.1",
    "lightweight-charts": "^5.2.0",
    "nuxt": "^3.0.0",
    "primeicons": "^8.0.0",
    "vue-chartjs": "^5.3.4",
    "zod": "^4.4.3"
  },
  "overrides": {
    "esbuild": "0.25.12"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/test-utils": "^4.1.0",
    "@playwright/test": "^1.62.1",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "firebase-tools": "^15.26.0",
    "happy-dom": "^20.11.1",
    "jsdom": "^30.0.1",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.9"
  }
}
